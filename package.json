{
  "name": "swipe-miniapp-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB --prefix-colors magenta,cyan \"npm:api\" \"npm:frontend\"",
    "api": "wrangler dev --local --port 8788 --var DEMO_MODE:true --var ALLOWED_ORIGIN:http://localhost:8787",
    "frontend": "vite --host 127.0.0.1 --port 8787 --strictPort",
    "build": "vite build",
    "db:init": "wrangler d1 execute swipe-miniapp-showcase --local --file=./schema.sql",
    "check": "tsc --noEmit && vite build",
    "bundle": "npm run build && ./scripts/package-bundle.sh",
    "verify": "npm run check && npm run bundle && ./scripts/validate-bundle.sh dist/swipe-miniapp-demo.zip",
    "deploy:api": "wrangler deploy",
    "test": "wrangler deploy --dry-run --outdir .test-worker && node tests/api.mjs",
    "bundle:release": "node scripts/check-release.mjs && npm run verify"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
